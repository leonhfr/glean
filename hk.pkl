amends "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Builtins.pkl"

local checks = new Mapping<String, Step> {
    ["gitleaks"] = Builtins.gitleaks
    ["golangci-fmt"] = Builtins.golangci_lint_fmt
    ["golangci-lint"] = Builtins.golangci_lint
    ["golangci-config"] = {
        glob = List(".golangci.yml", "hk.pkl", "mise.toml")
        check = "golangci-lint config verify"
    }
    ["gomod-tidy"] = Builtins.gomod_tidy
    ["json-fmt"] = Builtins.jq
    ["large-files"] = Builtins.check_added_large_files
    ["markdown-fmt"] = Builtins.rumdl_format
    ["markdown-lint"] = Builtins.rumdl
    ["merge-conflict"] = Builtins.check_merge_conflict
    ["test"] = {
        glob = List("**/*.go", "go.mod", "go.sum", "**/testdata/**", "mise.toml", "hk.pkl")
        check = "mise run test"
    }
    ["toml-fmt"] = Builtins.taplo_format
    ["toml-lint"] = Builtins.taplo
    ["typos"] = Builtins.typos
    ["yaml-fmt"] = Builtins.yamlfmt
    ["yaml-lint"] = Builtins.yamllint
}

hooks {
    ["pre-commit"] {
        fix = true
        steps = checks
    }
    ["check"] {
        steps = checks
    }
    ["fix"] {
        fix = true
        steps = checks
    }
    ["commit-msg"] {
        steps {
            ["conventional-commit"] = Builtins.check_conventional_commit
        }
    }
}
